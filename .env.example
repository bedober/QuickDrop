# NextAuth / Vercel
# Set this to your production Vercel URL, e.g. https://quickdrop-ug.vercel.app
NEXTAUTH_URL=https://your-domain.vercel.app
NEXTAUTH_SECRET=generate-a-long-random-secret

# Google OAuth
# Google callback URI: https://your-domain.vercel.app/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Facebook OAuth
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# TikTok Login Kit
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=
